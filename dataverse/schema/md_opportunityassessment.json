  "table": {
    "displayName": "Opportunity Assessment",
    "pluralDisplayName": "Opportunity Assessments",
    "logicalName": "md_opportunityassessment",
    "schemaName": "md_OpportunityAssessment",
    "ownership": "UserOwned",
    "enableAuditing": true,
    "primaryNameColumn": { "displayName": "Assessment Name", "logicalName": "md_name", "schemaName": "md_Name", "type": "Text", "maxLength": 200, "required": true },
    "columns": [
