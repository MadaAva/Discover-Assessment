{
  "solution": { "displayName": "MD Discover Assessment", "uniqueName": "MDDiscoverAssessment", "publisherPrefix": "md" },
  "normalizationNotes": [
    "Stakeholder rows are assessment-to-contact assignments; keep role and engagement attributes on the assignment, not on Contact.",
    "Executive Sponsor Identified and Decision Maker Identified on the assessment are transitional summary fields. Derive them from stakeholder roles in the app, then retire them after migrating the scoring workflow. Stakeholder Map Completed remains an assessment workflow flag.",
    "Assessment History is append-only snapshot history. Dataverse auditing remains the source for field-level audit events.",
    "Assessment Notes are structured records. Use native Dataverse Notes (annotation) instead when the requirement is only free-form notes or attachments."
  ],
